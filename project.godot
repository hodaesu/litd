[application]
config/name="Light in the Dark"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3")

[autoload]
DataLoader="*res://scripts/core/data_loader.gd"
EquipmentManager="*res://scripts/core/equipment_manager.gd"
CreatureManager="*res://scripts/core/creature_manager.gd"
HeroSkillManager="*res://scripts/core/hero_skill_manager.gd"
PoliticalState="*res://scripts/core/political_state.gd"
GameState="*res://scripts/core/game_state.gd"
SanctuaryState="*res://scripts/core/sanctuary_state.gd"
PoliticalUI="*res://scripts/ui/political_ui.gd"
SaveManager="*res://scripts/core/save_manager.gd"
ExpeditionManager="*res://scripts/core/expedition_manager.gd"
AshlandsMinibossDirector="*res://scripts/world/ashlands_miniboss_director.gd"
AshlandsRuntime="*res://scripts/world/ashlands_zone_runtime.gd"
AshlandsSceneRouter="*res://scripts/world/ashlands_scene_router.gd"
AshlandsCombatBridge="*res://scripts/world/ashlands_combat_bridge.gd"
AshlandsPlaytestSession="*res://scripts/world/ashlands_playtest_session.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
confirm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194309), Object(InputEventKey,"physical_keycode":32)]
}
back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":81), Object(InputEventKey,"physical_keycode":4194311)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194313)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":90), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventKey,"physical_keycode":32)]
}
camera_zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":61)]
}
camera_zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":45)]
}
