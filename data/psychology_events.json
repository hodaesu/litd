      "tags":["horror_discovery","judgement"],"trace":{"threshold":75,"chance":0.4,"pool":["judgement_fixation","ash_dissociation"]},
      "log":"Le chemin des jugements n'effraie pas chacun de la même manière.","once_per_campaign":true
    },
    {
