      "hope":{"title":"ESPOIR","text":"Quelqu'un avait encore préparé une place pour les autres.","fear_relief":4,"temporary_madness_resistance":10},
      "once_per_campaign":true
    },
    {
      "id":"ashlands_last_campfire_before_boss","trigger":"campfire_used","filter":{"zone_id":"zone_12_abbaye"},"scope":"party","fear_delta":-8,"stabilize_exposure":8,
