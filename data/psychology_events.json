{
  "version": 3,
  "design_source": "terre_des_cendres_psychology_pass_04",
  "core_rule": "La Peur décrit une réaction immédiate, les traces psychologiques décrivent des vécus humains variables, et la Folie du Voile désigne exclusivement une exposition surnaturelle. Ces trois systèmes ne sont jamais assimilés à une maladie mentale réelle.",
  "terminology": {
    "veil_folie": "Phénomène surnaturel propre au Voile ; ce n'est ni un diagnostic psychiatrique ni un synonyme de maladie mentale.",
    "fear": "Réaction humaine contextuelle qui varie selon la personne et la situation.",
    "trace": "Mémoire, habitude de protection ou réaction persistante issue d'une expérience ; une trace n'est pas automatiquement une pathologie.",
    "legacy_runtime_key": "Les clés techniques contenant madness sont conservées temporairement pour compatibilité et signifient uniquement résistance/exposition à la Folie du Voile.",
    "forbidden_equivalences": [
      "mental_illness_equals_violence",
      "mental_illness_equals_evil",
      "mental_illness_equals_supernatural_perception",
      "trauma_always_breaks_or_strengthens",
      "fear_equals_cowardice"
    ]
  },
  "fear_bands": [
    {"id":"calm","label":"Calme","min":0,"max":24},
    {"id":"uneasy","label":"Inquiet","min":25,"max":49},
    {"id":"afraid","label":"Effrayé","min":50,"max":74},
    {"id":"terrified","label":"Terrifié","min":75,"max":99},
    {"id":"panic","label":"Panique","min":100,"max":100}
  ],
  "combat_rules": {
    "bands": {
      "calm":{"precision":0,"damage_percent":0,"healing_power":0},
      "uneasy":{"precision":-2,"damage_percent":0,"healing_power":0},
      "afraid":{"precision":-5,"damage_percent":-5,"healing_power":-5},
      "terrified":{"precision":-10,"damage_percent":-10,"healing_power":-10},
      "panic":{"precision":-15,"damage_percent":-15,"healing_power":-15}
    },
    "panic":{"fear_after_crisis":85,"fear_after_resolve":70,"resolve_charges_max":1,"default_reaction":"freeze"},
    "hope_manifestation_resolve_charges":1,
    "hope_bands": {
      "dormant":{"precision":0,"damage_percent":0,"healing_power":0,"fear_resistance":0,"guard_power":0},
      "resolved":{"precision":1,"damage_percent":0,"healing_power":2,"fear_resistance":3,"guard_power":0},
      "inspired":{"precision":4,"damage_percent":4,"healing_power":6,"fear_resistance":8,"guard_power":4},
      "exalted":{"precision":7,"damage_percent":7,"healing_power":10,"fear_resistance":12,"guard_power":7}
    }
  },
  "trait_definitions": {
    "judgement_fixation": {
      "label":"Fixation du jugement","kind":"protective_trace","non_diagnostic":true,"fear_penalty_scale":1.1,"panic_reaction":"freeze",
      "fear_multipliers":{"judgement":1.15,"memory":0.9}
    },
    "ash_dissociation": {
      "label":"Distance aux cendres","kind":"protective_trace","non_diagnostic":true,"fear_penalty_scale":0.75,"panic_reaction":"retreat",
      "fear_multipliers":{"horror_discovery":0.82,"ally_critical":1.2}
    },
    "identity_detachment": {
      "label":"Distance à l'identité","kind":"protective_trace","non_diagnostic":true,"fear_penalty_scale":0.85,"panic_reaction":"retreat",
      "fear_multipliers":{"identity":0.8,"isolation":1.2}
    },
    "name_obsession": {
      "label":"Fixation sur les noms","kind":"memory_trace","non_diagnostic":true,"fear_penalty_scale":1.05,"panic_reaction":"freeze",
      "fear_multipliers":{"identity":1.18,"memory":0.88}
    },
    "panic_memory": {
      "label":"Mémoire de panique","kind":"stress_memory","non_diagnostic":true,"fear_penalty_scale":1.15,"panic_reaction":"retreat",
      "fear_multipliers":{"terrifying_enemy":1.12,"community":0.92}
    },
    "mutilation_echo": {
      "label":"Écho de mutilation","kind":"stress_memory","non_diagnostic":true,"fear_penalty_scale":1.1,"panic_reaction":"freeze",
      "fear_multipliers":{"dismemberment":1.15,"victory":0.9}
    }
  },
  "events": [
    {
