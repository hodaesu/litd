    {
      "id":"ashlands_shortcut_opened","trigger":"shortcut_unlocked","scope":"party","fear_delta":-2,"tags":["progress","community"],
      "hope":{"title":"ESPOIR","text":"Une route restera ouverte même si cette expédition échoue.","fear_relief":1,"temporary_madness_resistance":4}
    },
    {
      "id":"ashlands_inspiring_text","trigger":"lore_discovered","filter":{"collection":"hope_vigils"},"scope":"party","fear_delta":-2,"tags":["memory","hope_text"],
      "hope":{"title":"ESPOIR","text":"Un texte ancien rappelle que l'espoir était déjà un acte, pas une promesse.","fear_relief":2,"temporary_madness_resistance":6}
    },
    {
      "id":"ashlands_boss_victory","trigger":"combat_finished","filter":{"encounter_type":"boss","victory":true},"scope":"party","fear_delta":-6,"tags":["victory","community"],
