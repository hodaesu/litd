    },
    {
      "id":"combat_ally_support","trigger":"manual","scope":"targets","fear_delta":-2,"tags":["ally_support","community"],
      "hope":{"title":"ESPOIR","text":"Un geste de soutien suffit parfois à empêcher la peur de décider seule.","fear_relief":1,"temporary_madness_resistance":5}
    },
    {
      "id":"sanctuary_chapel_appease","trigger":"manual","scope":"targets","fear_delta":-18,"stabilize_exposure":12,"tags":["sanctuary","care"],
      "hope":{"title":"ESPOIR","text":"L'apaisement ne supprime pas les traces ; il rend de nouveau possible le choix.","temporary_madness_resistance":12}
    },
