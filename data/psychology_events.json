    },
    {
      "id":"sanctuary_memorial_remembrance","trigger":"manual","scope":"targets","fear_delta":-2,"tags":["sanctuary","memory","community"],
      "hope":{"title":"ESPOIR","text":"Se souvenir n'efface pas l'absence, mais empêche qu'elle soit totale.","fear_relief":2,"temporary_madness_resistance":6}
    }
  ],
  "hope_bands": [
