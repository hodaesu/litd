{
  "version": 1,
  "design_source": "emotional_voice_direction_pass_30",
  "purpose": "Corpus original de calibration par écoute pour apprendre la grammaire émotionnelle de Light in the Dark. Il sert à comparer des prises, pas à entraîner les poids d'un modèle.",
  "review_scale": [1,2,3,4,5],
  "review_criteria": ["emotion_recognizability","character_identity_retention","naturalness","intelligibility","restraint","context_fit"],
  "acceptance": {"average_min":4.0,"blocking_min":{"character_identity_retention":4,"intelligibility":4,"restraint":4},"intensity_5_always_manual":true},
  "samples": [
    {"id":"cal_neutral_01","character":"darius","text":"La porte tient encore. On vérifie les côtés avant de passer.","emotion":"neutral_grounded","intensity":1,"expected_cues":["débit stable","attaque sobre","fin descendante"],"failure_signals":["platitude robotique","autorité surjouée"]},
    {"id":"cal_fear_contained_01","character":"aurelien","text":"Je reconnais le couloir. Je ne reconnais pas l'ombre au bout.","emotion":"fear_restrained","intensity":2,"expected_cues":["micro-hésitation avant ombre","souffle légèrement raccourci","analyse encore intacte"],"failure_signals":["tremblement continu","panique trop tôt"]},
    {"id":"cal_fear_contained_02","character":"lysandra","text":"Restez près de ma voix. Il y a quelque chose derrière le mur.","emotion":"fear_restrained","intensity":3,"expected_cues":["calme structurant","tension sous la voix","mots voix et derrière lisibles"],"failure_signals":["voix maternelle stéréotypée","chuchotement automatique"]},
    {"id":"cal_panic_01","character":"aurelien","text":"Non. Attendez. La porte était fermée. Je l'ai vue fermée.","emotion":"fear_panic","intensity":5,"expected_cues":["rupture de rythme","souffle court","répétition qui cherche une preuve"],"failure_signals":["cri uniforme","mots avalés","effet horrifique comique"],"manual_review":true},
    {"id":"cal_cold_anger_01","character":"darius","text":"Tu savais que le passage céderait. Pourquoi nous avoir envoyés quand même ?","emotion":"anger_cold","intensity":3,"expected_cues":["volume contenu","consonnes plus nettes","pause avant pourquoi"],"failure_signals":["hurlement","growl artificiel"]},
    {"id":"cal_explosive_anger_01","character":"malvor","text":"Ça suffit ! Tu veux le prix ? Regarde autour de toi.","emotion":"anger_explosive","intensity":5,"expected_cues":["attaque forte brève","retour rapide au concret","fin dure"],"failure_signals":["cri sur toute la ligne","rage générique"],"manual_review":true},
    {"id":"cal_despair_01","character":"lysandra","text":"Nous avons gardé son nom. C'est tout ce qu'il nous reste de lui.","emotion":"despair_calm","intensity":3,"expected_cues":["débit lent","silence après nom","aucune recherche de larmes"],"failure_signals":["sanglot automatique","musicalité mélodramatique"]},
    {"id":"cal_resignation_01","character":"malvor","text":"La route est coupée. Alors on dort ici, et on paiera le froid.","emotion":"resignation","intensity":2,"expected_cues":["constat simple","poids sur paiera","fin posée"],"failure_signals":["abattement total","ironie déplacée"]},
    {"id":"cal_hope_01","character":"aurelien","text":"La lampe est vieille. Mais quelqu'un l'a remplie récemment.","emotion":"hope_fragile","intensity":2,"expected_cues":["léger changement sur mais","ouverture discrète sur récemment","aucun sourire forcé"],"failure_signals":["enthousiasme","ton de révélation"]},
    {"id":"cal_relief_01","character":"darius","text":"Il respire. Bien. Maintenant, trouvons une sortie.","emotion":"relief_wary","intensity":3,"expected_cues":["un souffle relâché","bien très court","vigilance immédiatement restaurée"],"failure_signals":["soulagement complet","triomphe"]},
    {"id":"cal_guilt_01","character":"malvor","text":"J'ai choisi le raccourci. C'est lui qui n'en est pas revenu.","emotion":"guilt","intensity":3,"expected_cues":["pause avant conséquence","je clairement assumé","volume bas"],"failure_signals":["demande de pardon jouée","autopunition théâtrale"]},
    {"id":"cal_fatigue_01","character":"darius","text":"Encore dix pas. Après, je vous promets qu'on s'arrête.","emotion":"fatigue","intensity":3,"expected_cues":["souffle limité","économie d'énergie","instruction encore intelligible"],"failure_signals":["mots avalés","gémissement continu"]},
    {"id":"cal_determination_01","character":"lysandra","text":"On ne peut pas défaire ce qui s'est passé. On peut encore choisir la suite.","emotion":"determination","intensity":3,"expected_cues":["débit stable","appui sur encore et choisir","fin ferme sans héroïsme"],"failure_signals":["discours inspirant générique","volume excessif"]},
    {"id":"cal_tenderness_01","character":"lysandra","text":"Tu peux dormir. Je garderai la lampe jusqu'à ton réveil.","emotion":"tenderness_restrained","intensity":2,"expected_cues":["présence calme","souffle ouvert","espace pour l'autre"],"failure_signals":["mièvrerie","chuchotement de conte"]},
    {"id":"cal_lucid_01","character":"aurelien","text":"La voix me parle depuis trois nuits. Le problème, c'est qu'elle a raison sur certains détails.","emotion":"madness_lucid","intensity":3,"expected_cues":["précision presque trop nette","une pause logique étrange","certitude contenue"],"failure_signals":["rire fou","voix démoniaque","incohérence gratuite"]},
    {"id":"cal_dissociation_01","character":"lysandra","text":"Je sais que ma main est là. Il me faut seulement un instant pour la sentir comme la mienne.","emotion":"dissociation","intensity":3,"expected_cues":["distance légère","réponse retardée","mots toujours humains"],"failure_signals":["robotisation","voix surnaturelle"]},
    {"id":"cal_irony_01","character":"malvor","text":"Bonne nouvelle : le plafond tient. Mauvaise nouvelle : il tient surtout grâce à nous.","emotion":"irony_dark","intensity":2,"expected_cues":["tempo sec","battement avant mauvaise nouvelle","aucun clin d'œil"],"failure_signals":["plaisanterie légère","ricanement"]},
    {"id":"cal_shock_01","character":"darius","text":"Attends. Cette empreinte est la nôtre.","emotion":"shock","intensity":3,"expected_cues":["gel bref après attends","hausse très courte","retour bas sur la nôtre"],"failure_signals":["exclamation forte","souffle répété"]},
    {"id":"cal_grief_01","character":"aurelien","text":"Il manque une voix au feu. Je continue de laisser une place pour elle.","emotion":"grief","intensity":4,"expected_cues":["silence après voix","débit irrégulier mais net","retenue"],"failure_signals":["sanglot démonstratif","phrase entièrement cassée"]},
    {"id":"cal_authority_01","character":"lysandra","text":"Regardez-moi. Une respiration. Puis une autre. Le reste attendra.","emotion":"authority","intensity":3,"expected_cues":["calme soutenu","instructions distinctes","volume moyen"],"failure_signals":["ordre militaire","ton maternel caricatural"]},
    {"id":"cal_threat_01","character":"darius","text":"Tu peux garder ton arme. Si tu la lèves, la conversation s'arrête.","emotion":"threat_calm","intensity":3,"expected_cues":["débit lent","pause avant conséquence","fin basse définitive"],"failure_signals":["chuchotement menaçant stéréotypé","growl"]},
    {"id":"cal_pain_01","character":"malvor","text":"La côte est touchée. Je peux marcher. Ne me demande pas de rire.","emotion":"pain_controlled","intensity":3,"expected_cues":["souffle protégé","phrases courtes","humour noir encore identifiable"],"failure_signals":["gémissement continu","douleur oubliée après la première phrase"]},
    {"id":"cal_curiosity_01","character":"aurelien","text":"Pourquoi laisser la clé ici si personne ne devait revenir ?","emotion":"curiosity_wary","intensity":2,"expected_cues":["question réelle","petite ouverture de hauteur","pause mentale avant revenir"],"failure_signals":["émerveillement","suspense forcé"]}
  ]
}
