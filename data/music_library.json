{
  "version": 1,
  "design_source": "narrative_music_library_pass_17",
  "asset_status": "catalog_only_no_audio_binaries",
  "purpose": "Curated music candidates and scoring rules for exploration, combat, emotion, Sanctuary, lore and narrative transitions in Light in the Dark.",
  "license_policy": {
    "shipping_green": [
      "pixabay_content_license_verified_item_no_content_id_badge_observed",
      "cc0_1_0_verified"
    ],
    "shipping_amber": [
      "pixabay_content_id_registered_keep_certificate_and_test_claims",
      "cc_by_4_0_attribution_and_platform_review",
      "musopen_verify_each_recording"
    ],
    "shipping_red": [
      "video_game_use_prohibited",
      "noncommercial_only",
      "unclear_or_conflicting_extra_restrictions",
      "recognizable_franchise_identity_risk"
    ],
    "evidence_required_before_ingestion": [
      "source_url",
      "license_url",
      "license_tier",
      "checked_at",
      "creator_name",
      "track_title",
      "content_id_status",
      "license_snapshot_or_certificate_when_available",
      "sha256_after_local_ingestion"
    ],
    "rules": [
      "A track is never considered cleared merely because a site calls it royalty-free.",
      "Verify the item page and source license again on the actual download day.",
      "Do not redistribute a stock track as a standalone music file outside the game package.",
      "Keep attribution and license evidence beside every ingested asset even when attribution is not mandatory.",
      "Content-ID registered tracks remain amber until claim behavior is tested and proof of license is archived.",
      "CC BY tracks require complete attribution and platform/legal review before an iOS shipping build.",
      "CC0 is preferred when a suitable recording is genuinely released under CC0.",
      "Reject tracks carrying contradictory creator restrictions unless a direct commercial license is obtained.",
      "Reject music whose identity is too dependent on recognizable protected franchises even if the stock license permits use."
    ]
  },
  "sources": [
