  "cue_families": [
    {"id": "exploration_ashlands", "label": "Terres de Cendre", "energy": [1, 3], "intent": "solitude, ash, distance, fragile forward motion"},
    {"id": "exploration_ruins", "label": "Ruines et souterrains", "energy": [1, 3], "intent": "age, mystery, buried history, spatial unease"},
    {"id": "exploration_threat", "label": "Exploration sous menace", "energy": [2, 4], "intent": "danger approaching without forcing combat immediately"},
    {"id": "combat_normal", "label": "Combat courant", "energy": [3, 5], "intent": "readable pulse, danger, tactical forward drive"},
    {"id": "combat_elite", "label": "Élite et mini-boss", "energy": [4, 5], "intent": "heavier scale and escalating pressure"},
    {"id": "combat_boss", "label": "Boss", "energy": [4, 5], "intent": "signature scale, dread, resolve and transformation"},
    {"id": "boss_intro", "label": "Entrée de boss", "energy": [2, 5], "intent": "anticipation before impact"},
    {"id": "boss_phase_change", "label": "Changement de phase", "energy": [4, 5], "intent": "clear musical turn that supports a mechanical turn"},
    {"id": "sadness_loss", "label": "Perte et tristesse", "energy": [1, 2], "intent": "grief without sentimental overstatement"},
    {"id": "memorial", "label": "Mémorial", "energy": [1, 2], "intent": "memory, absence, respect and unresolved bonds"},
    {"id": "emotional_reunion", "label": "Retrouvailles", "energy": [1, 3], "intent": "recognition, tenderness and complicated relief"},
    {"id": "hope_manifestation", "label": "Manifestation d'Espoir", "energy": [1, 4], "intent": "brief emergence of possibility rather than permanent triumph"},
    {"id": "sanctuary_day", "label": "Sanctuaire calme", "energy": [1, 2], "intent": "safety earned but never absolute"},
    {"id": "sanctuary_night", "label": "Sanctuaire nocturne", "energy": [1, 2], "intent": "intimacy, fatigue and quiet uncertainty"},
    {"id": "tavern", "label": "Taverne", "energy": [1, 4], "intent": "human warmth, social texture, rumor and fragile celebration"},
    {"id": "chapel", "label": "Chapelle", "energy": [1, 2], "intent": "contemplation, mourning, vows and inner conflict"},
    {"id": "political_tension", "label": "Tension politique", "energy": [1, 3], "intent": "competing interests, restraint and unstable consensus"},
    {"id": "ancient_archive", "label": "Archives anciennes", "energy": [1, 3], "intent": "discovery of a past that changes the present"},
    {"id": "fear_panic", "label": "Peur et panique", "energy": [2, 5], "intent": "loss of control, narrowing attention, urgent threat"},
    {"id": "madness_trace", "label": "Trace de folie", "energy": [1, 3], "intent": "cognitive fracture and wrongness without a constant madness meter"},
    {"id": "creature_empathy", "label": "Créature consciente", "energy": [1, 3], "intent": "strangeness, recognition and moral ambiguity"},
    {"id": "discovery_revelation", "label": "Révélation", "energy": [1, 4], "intent": "knowledge opening rather than simple victory"},
    {"id": "victory_costly", "label": "Victoire coûteuse", "energy": [1, 3], "intent": "achievement mixed with loss and exhaustion"},
    {"id": "defeat_retreat", "label": "Défaite ou retraite", "energy": [1, 3], "intent": "survival, consequence and unfinished purpose"},
    {"id": "chapter_transition", "label": "Transition de chapitre", "energy": [1, 4], "intent": "new horizon while preserving memory of the last chapter"},
    {"id": "ending_choice", "label": "Choix de fin", "energy": [1, 5], "intent": "weight of responsibility without telling the player which answer is moral"},
    {"id": "credits", "label": "Générique", "energy": [1, 4], "intent": "motif synthesis, remembrance and aftermath"}
  ],
