  "adaptive_score_rules": [
    "Music follows dramatic state, not merely location: calm exploration can become threat without replacing every environmental identity.",
    "Prefer layered or crossfaded escalation over hard cuts when exploration turns into ordinary combat.",
    "Boss introductions may use silence or a restrained cue before the full battle layer enters.",
    "A boss phase change needs an audible structural turn, but the music must never hide telegraphs or combat readability.",
    "Fear/Panic cues should narrow and destabilize rather than simply become louder.",
    "Hope manifestations should be brief musical openings; do not turn Hope into a permanent triumphant soundtrack.",
    "Loss scenes leave room for silence. Music may enter late or end early so dialogue and breathing can carry the scene.",
    "Sanctuary music must preserve traces of the outside world; safety is earned, not absolute.",
    "Ancient archives favor timbral identity and mystery over generic heroic swell.",
    "Political scenes use tension and restraint rather than moralizing major/minor shorthand.",
    "Creature-empathy scenes should preserve strangeness; avoid automatically making non-human characters cute or sacred.",
    "The ending choice must not musically label one option as the correct moral answer before the player commits.",
    "Use recurring original LITD motifs in future bespoke compositions so stock tracks become temporary/reference material rather than the final identity of the game."
  ],
  "mix_priorities": {
    "dialogue_ducking_db": -5,
    "critical_voice_line_ducking_db": -8,
    "combat_telegraph_priority": "above_music",
    "ui_confirm_priority": "above_music",
    "ambient_bed_priority": "below_music",
    "notes": "Values are production defaults to tune in-device; narrative intelligibility and gameplay telegraphs outrank score loudness."
  },
