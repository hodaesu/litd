{
  "schema_version": 7,
  "policy": {
    "fast_feedback_target_seconds": 90,
    "reproducibility": "Every randomized bot must report deterministic seed and case/run index.",
    "flakiness": "Do not hide failures with blind retries or arbitrary sleeps; wait on observable game state and preserve the failing seed.",
    "maturity": "After v31, freeze routine bot-number growth. Add a new numbered bot only for a genuinely new mechanic or demonstrated blind spot.",
    "tiers": {
      "sentinel": "Run on every relevant commit; small deterministic contract checks.",
      "simulation": "Run in parallel on every relevant commit; medium/long gameplay simulation.",
      "telemetry": "Statistical balance signal; never substitutes for production-runtime tests.",
      "diagnostic": "Runs after or alongside sentinels to replay, classify, reduce, and compare regressions.",
      "adversarial": "Actively searches for dominant strategies, exploit loops, invalid state transitions and recovery failures.",
      "governance": "Measures fleet usefulness, overlap and maturity; controls whether new bot families are justified."
    }
  },
