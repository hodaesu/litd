{
  "version": 1,
  "purpose": "Piloter posture, locomotion et animation de combat depuis les états de gameplay sans coder le gameplay dans Blender.",
  "authority": {
    "gameplay_timing": "Godot",
    "visual_motion": "AnimationTree/Blender clips",
    "damage_events": "Godot markers",
    "root_motion": "allowlisted only"
  },
  "thresholds": {
    "hp_critical_max": 0.25,
    "hp_injured_max": 0.6,
    "fear_tense_min": 35,
    "fear_terrified_min": 75,
    "fear_panic_min": 100,
    "madness_fractured_min": 75,
    "hope_manifest_min": 70
  },
  "priority": [
    "death",
    "critical_injury",
    "panic",
    "fractured",
    "terrified",
    "injured",
    "despair",
    "anger",
    "hope",
    "tense",
    "neutral"
  ],
