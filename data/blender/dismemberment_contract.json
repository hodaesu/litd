{
  "schema_version": 1,
  "rule": "Le rig graphique doit représenter exactement les parties ciblables du gameplay. Le niveau de gore ne modifie jamais la mécanique.",
  "naming": {
    "bone_prefix": "BONE_",
    "sever_socket_prefix": "SEVER_",
    "detached_mesh_prefix": "DETACHED_",
    "wound_cap_prefix": "CAP_",
    "vfx_socket_prefix": "FX_",
    "injury_shape_prefix": "INJ_"
  },
  "required_collections": ["BODY", "ARMATURE", "DISMEMBERMENT", "WOUND_CAPS", "SOCKETS", "VFX_GUIDES"],
  "generic_profiles": {
    "humanoid": {
      "weapon_arm": {"bone":"BONE_weapon_arm","sever_socket":"SEVER_weapon_arm","detached_mesh":"DETACHED_weapon_arm","wound_cap":"CAP_weapon_arm","vfx_socket":"FX_weapon_arm"},
      "support_leg": {"bone":"BONE_support_leg","sever_socket":"SEVER_support_leg","detached_mesh":"DETACHED_support_leg","wound_cap":"CAP_support_leg","vfx_socket":"FX_support_leg"},
      "head": {"bone":"BONE_head","sever_socket":"SEVER_head","detached_mesh":"DETACHED_head","wound_cap":"CAP_head","vfx_socket":"FX_head"}
    },
    "beast": {
      "forelimb": {"bone":"BONE_forelimb","sever_socket":"SEVER_forelimb","detached_mesh":"DETACHED_forelimb","wound_cap":"CAP_forelimb","vfx_socket":"FX_forelimb"},
      "hind_leg": {"bone":"BONE_hind_leg","sever_socket":"SEVER_hind_leg","detached_mesh":"DETACHED_hind_leg","wound_cap":"CAP_hind_leg","vfx_socket":"FX_hind_leg"},
      "jaw": {"bone":"BONE_jaw","sever_socket":"SEVER_jaw","detached_mesh":"DETACHED_jaw","wound_cap":"CAP_jaw","vfx_socket":"FX_jaw"}
    },
    "arachnid": {
      "front_leg": {"bone":"BONE_front_leg","sever_socket":"SEVER_front_leg","detached_mesh":"DETACHED_front_leg","wound_cap":"CAP_front_leg","vfx_socket":"FX_front_leg"},
      "venom_appendage": {"bone":"BONE_venom_appendage","sever_socket":"SEVER_venom_appendage","detached_mesh":"DETACHED_venom_appendage","wound_cap":"CAP_venom_appendage","vfx_socket":"FX_venom_appendage"},
      "rear_leg": {"bone":"BONE_rear_leg","sever_socket":"SEVER_rear_leg","detached_mesh":"DETACHED_rear_leg","wound_cap":"CAP_rear_leg","vfx_socket":"FX_rear_leg"}
    },
    "aberration": {
      "attack_appendage": {"bone":"BONE_attack_appendage","sever_socket":"SEVER_attack_appendage","detached_mesh":"DETACHED_attack_appendage","wound_cap":"CAP_attack_appendage","vfx_socket":"FX_attack_appendage"},
      "anchor_appendage": {"bone":"BONE_anchor_appendage","sever_socket":"SEVER_anchor_appendage","detached_mesh":"DETACHED_anchor_appendage","wound_cap":"CAP_anchor_appendage","vfx_socket":"FX_anchor_appendage"}
    },
    "construct": {
      "impact_plate": {"bone":"BONE_impact_plate","sever_socket":"","detached_mesh":"","wound_cap":"","vfx_socket":"FX_impact_plate","injury_shape":"INJ_impact_plate_cracked"},
      "joint": {"bone":"BONE_joint","sever_socket":"","detached_mesh":"","wound_cap":"","vfx_socket":"FX_joint","injury_shape":"INJ_joint_broken"},
      "core": {"bone":"BONE_core","sever_socket":"","detached_mesh":"","wound_cap":"","vfx_socket":"FX_core","injury_shape":"INJ_core_cracked"}
    },
    "boss": {
      "offensive_limb": {"bone":"BONE_offensive_limb","sever_socket":"SEVER_offensive_limb","detached_mesh":"DETACHED_offensive_limb","wound_cap":"CAP_offensive_limb","vfx_socket":"FX_offensive_limb"},
      "anchor_limb": {"bone":"BONE_anchor_limb","sever_socket":"SEVER_anchor_limb","detached_mesh":"DETACHED_anchor_limb","wound_cap":"CAP_anchor_limb","vfx_socket":"FX_anchor_limb"},
      "support_limb": {"bone":"BONE_support_limb","sever_socket":"SEVER_support_limb","detached_mesh":"DETACHED_support_limb","wound_cap":"CAP_support_limb","vfx_socket":"FX_support_limb"}
    }
  },
  "unique_boss_naming": {
    "mode":"part_id_driven",
    "bone":"BONE_{part_id}",
    "sever_socket":"SEVER_{part_id}",
    "detached_mesh":"DETACHED_{part_id}",
    "wound_cap":"CAP_{part_id}",
    "vfx_socket":"FX_{part_id}",
    "injury_shape":"INJ_{part_id}_{state}"
  },
  "presentation_modes": {
    "full": {
      "detached_mesh":true,
      "wound_cap":true,
      "blood_spray":true,
      "blood_decal":true,
      "exposed_tissue":true,
      "fallback":"dark_ash_for_non_biological"
    },
    "reduced": {
      "detached_mesh":false,
      "wound_cap":true,
      "blood_spray":false,
      "blood_decal":false,
      "exposed_tissue":false,
      "fallback":"shadow_flash_and_ash"
    },
    "off": {
      "detached_mesh":false,
      "wound_cap":false,
      "blood_spray":false,
      "blood_decal":false,
      "exposed_tissue":false,
      "fallback":"hit_reaction_plus_anatomy_ui_only"
    }
  },
  "animation_contract": {
    "required_generic": ["hit_anatomy","injury_react","critical_injury_react","dismember_react","guard_remaining_part","wounded_rage","wounded_retreat","panic_flee","phase_altered"],
    "per_part_patterns": ["hit_{part_id}","injury_{part_id}","critical_{part_id}","dismember_{part_id}"],
    "boss_phase_event":"phase_altered_{part_id}"
  },
  "godot_events": {
    "injury":"anatomy_injury",
    "critical_injury":"anatomy_critical",
    "dismemberment":"anatomy_severed",
    "boss_phase_change":"boss_anatomy_phase_altered"
  },
  "export": {
    "format":"glb",
    "apply_transforms":true,
    "preserve_armature_names":true,
    "separate_detached_meshes":true,
    "include_custom_properties":true
  }
}
