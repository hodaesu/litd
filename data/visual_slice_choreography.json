  "defeat": {
    "condition": "darius_hp_reaches_zero",
    "death_animation_must_complete_before_result": true,
    "result_hold_s": 1.5,
    "audio_resolution": "combat_finish_defeat"
  },
  "readability_rules": [
    "un impact ne peut jamais précéder le télégraphe visuel",
    "aucun VFX ne masque la silhouette du bras ou de l'arme au marqueur d'impact",
    "la caméra revient au cadrage tactique avant le prochain choix",
    "les animations n'ajoutent jamais une pénalité tactique cachée",
    "les actions ennemies majeures doivent rester compréhensibles sans audio"
  ]
