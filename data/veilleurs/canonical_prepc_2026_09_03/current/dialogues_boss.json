    {"Boss":"Le Copiste","Moment":"phase_2","Locuteur":"LE COPISTE","Réplique":"Erreur observée. Correction.","Clé":"boss.le_copiste.phase_2.le_copiste"},
    {"Boss":"Le Copiste","Moment":"reply_2","Locuteur":"AÏSHA","Réplique":"Une blessure n’est pas une faute de copie.","Clé":"boss.le_copiste.reply_2.aisha"},
    {"Boss":"Le Copiste","Moment":"phase_3","Locuteur":"LE COPISTE","Réplique":"Deux versions cohérentes. Une seule doit rester commune.","Clé":"boss.le_copiste.phase_3.le_copiste"},
