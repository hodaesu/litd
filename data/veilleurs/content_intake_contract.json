{
  "schema_version": 1,
  "stage": "pre_pc_production_intake",
  "authority": "content_work_order_reservation",
  "rules": {
    "runtime_target": "Godot 4.3",
    "mobile_first": true,
    "presentation_never_decides_gameplay": true,
    "reservation_never_mutates_canonical_gameplay": true,
    "work_order_presence_reserves_id": true,
    "duplicate_canonical_ids_forbidden": true,
    "duplicate_reserved_ids_forbidden": true,
    "path_traversal_forbidden": true,
    "new_work_order_state": "intake_reserved",
    "generic_content_requires_refinement_before_canonicalization": true
  },
  "work_order_root": "data/veilleurs/intake/work_orders",
  "supported_types": {
    "watcher": {
      "id_prefix": "ENT_WATCHER_",
      "canonical_sources": ["data/veilleurs/v06/watchers.json", "data/veilleurs/skills"],
      "integration_targets": ["data", "skill_catalog", "runtime", "scene", "save", "ui", "tests", "production_assets"],
      "output_root_pattern": "res://assets/veilleurs/production/watchers/{slug}",
      "required_assets": ["model", "rig", "materials", "textures", "base_animation_set", "equipment", "portrait", "ui_icon", "injury_variants", "corpse_state"],
      "required_tests": ["canonical_roster_contract", "anatomy_body_state", "combat_runtime", "permadeath", "save_resume", "mobile_readability"],
      "required_gates": ["json_contracts", "strict_godot_import", "combat_smoke", "ui_journey", "hardware_visual_closeout"]
    },
    "enemy": {
      "id_prefix": "ENT_ENEMY_",
      "canonical_sources": ["data/veilleurs/v06/enemies_24_definitions.json"],
      "integration_targets": ["data", "combat_runtime", "capture_recruitment", "anatomy", "archive", "scene", "tests", "production_assets"],
      "output_root_pattern": "res://assets/veilleurs/production/enemies/{slug}",
      "required_assets": ["model", "rig_or_procedural_skeleton", "materials", "textures", "base_animation_set", "combat_readability", "injury_variants", "corpse_state", "archive_portrait"],
      "required_tests": ["enemy_definition_contract", "anatomy_body_state", "combat_runtime", "capture_rules", "corpse_remanence", "save_resume"],
      "required_gates": ["json_contracts", "strict_godot_import", "combat_smoke", "remanence_smoke", "hardware_visual_closeout"]
    },
    "boss": {
      "id_prefix": "ENT_BOSS_",
      "canonical_sources": ["data/veilleurs/v07/bosses_5_definitions.json"],
      "integration_targets": ["data", "boss_runtime", "phase_rules", "scene", "save", "tests", "production_assets"],
      "output_root_pattern": "res://assets/veilleurs/production/bosses/{slug}",
      "required_assets": ["model", "rig", "materials", "textures", "boss_animation_set", "phase_readability", "injury_variants", "corpse_or_defeat_state", "portrait"],
      "required_tests": ["boss_definition_contract", "phase_transitions", "recruitability_rule", "anatomy_body_state", "save_resume", "mobile_readability"],
      "required_gates": ["json_contracts", "strict_godot_import", "boss_phase_smoke", "save_resume_logic", "hardware_visual_closeout"]
    },
    "dungeon": {
      "id_prefix": "DUNGEON_",
      "canonical_sources": ["data/veilleurs/v09/wave3_contract.json"],
      "integration_targets": ["data", "dungeon_graph", "encounters", "navigation", "scene", "save", "tests", "production_assets"],
      "output_root_pattern": "res://assets/veilleurs/production/dungeons/{slug}",
      "required_assets": ["modular_geometry", "materials", "decals", "lighting_profile", "navigation_proxy", "collision_proxy", "landmarks", "ambient_audio_hooks", "lod_plan"],
      "required_tests": ["deterministic_graph", "node_navigation", "encounter_contract", "save_resume", "mobile_readability", "performance_budget"],
      "required_gates": ["json_contracts", "strict_godot_import", "dungeon_qa", "save_resume_logic", "hardware_performance_closeout"]
    },
    "ui_screen": {
      "id_prefix": "UI_",
      "canonical_sources": ["data/veilleurs/polish_manifest.json", "scripts/ui", "scenes/ui"],
      "integration_targets": ["ui_scene", "ui_script", "responsive_layout", "touch", "controller", "accessibility", "tests", "production_assets"],
      "output_root_pattern": "res://assets/veilleurs/production/ui/{slug}",
      "required_assets": ["frames_or_atlas", "icons", "states", "tutorial_markers", "accessibility_variants"],
      "required_tests": ["phone_layout", "tablet_layout", "desktop_layout", "touch_targets", "controller_focus", "reduced_motion", "safe_area_contract"],
      "required_gates": ["strict_godot_import", "mobile_touch_logic", "ui_player_journey", "hardware_safe_area_closeout", "hardware_visual_closeout"]
    },
    "ultimate": {
      "id_prefix": "ULT_",
      "canonical_sources": ["data/veilleurs/v08/canonical_watcher_ultimates_12.json", "data/veilleurs/ultimate_choreography_contract.json"],
      "integration_targets": ["data", "resolver", "combat_runtime", "presentation_hooks", "tests", "production_assets"],
      "output_root_pattern": "res://assets/veilleurs/production/ultimates/{slug}",
      "required_assets": ["animation", "camera", "vfx", "audio", "haptic", "ui"],
      "required_tests": ["resolver_contract", "gameplay_presentation_separation", "charge_progression", "reduced_motion", "reduced_gore", "haptics_off", "short_mode"],
      "required_gates": ["json_contracts", "strict_godot_import", "combat_smoke", "ultimate_handoff_contract", "hardware_haptic_audio_visual_closeout"]
    },
    "generic": {
      "id_prefix": "CONTENT_",
      "canonical_sources": [],
      "integration_targets": ["design_review", "type_refinement", "tests_plan", "production_plan"],
      "output_root_pattern": "res://assets/veilleurs/production/misc/{slug}",
      "required_assets": [],
      "required_tests": ["type_refinement_required"],
      "required_gates": ["content_intake_contract"],
      "cannot_canonicalize": true
    }
  }
}
