{
  "schema_version": 1,
  "project": "LITD : Les Veilleurs",
  "model": "five_stage_system_maturity",
  "stages": [
    {
      "id": "implemented",
      "rank": 1,
      "label_fr": "Implémenté",
      "meaning": "Le système existe dans le runtime ou dans une verticale jouable et ses dépendances principales sont présentes."
    },
    {
      "id": "technically_validated",
      "rank": 2,
      "label_fr": "Testé techniquement",
      "meaning": "Les tests, audits et smokes requis passent sur un commit précis sans erreur bloquante connue."
    },
    {
      "id": "player_validated",
      "rank": 3,
      "label_fr": "Compris par le joueur",
      "meaning": "Des playtests humains montrent que le joueur comprend les décisions, causes et conséquences sans coaching indu."
    },
    {
      "id": "mobile_validated",
      "rank": 4,
      "label_fr": "Validé mobile",
      "meaning": "Les interactions, la lisibilité, la performance et les contraintes matérielles sont validées sur appareil cible réel."
    },
    {
      "id": "production_locked",
      "rank": 5,
      "label_fr": "Verrouillé pour production",
      "meaning": "Les quatre preuves design, joueur, technique et reproductibilité de production sont réunies ; le procédé peut être répété à grande échelle."
    }
  ],
  "rules": {
    "stages_cannot_be_skipped": true,
    "human_evidence_required_from_rank": 3,
    "real_device_evidence_required_from_rank": 4,
    "production_lock_requires_four_proofs": ["design", "player", "technical", "production"],
    "ci_must_not_promote_human_or_device_stages": true,
    "regression_can_demote_a_system": true
