    {
      "id":"collision.same_band_same_urgency_age",
      "scheduler_seed":731903,
      "candidates":[
        {"memory_id":"m.a","priority_band":"DISCOVERY_OR_ARCHIVE","urgency":50,"age":2,"family":"DECOUVERTE","first_eligible_expedition":12},
        {"memory_id":"m.b","priority_band":"DISCOVERY_OR_ARCHIVE","urgency":50,"age":2,"family":"SOUVENIR","first_eligible_expedition":12}
      ],
      "expected":"stable_sha256_tiebreak_not_input_order",
