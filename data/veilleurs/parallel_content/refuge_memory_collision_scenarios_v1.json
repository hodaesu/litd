        {"memory_id":"m.rel.conflict","priority_band":"RELATIONSHIP_OR_DEPARTURE","urgency":55,"age":4,"family":"CONFLIT"}
      ],
      "expected_order":["m.rel.depart","m.rel.conflict"],
