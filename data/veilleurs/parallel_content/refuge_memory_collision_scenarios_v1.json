    {
      "id":"collision.surface_limit_preserves_remainder",
      "surface_limit":2,
      "candidates":[
        {"memory_id":"m.1","priority_band":"CRISIS","urgency":80,"family":"CRISE"},
        {"memory_id":"m.2","priority_band":"BODY_OR_AVAILABILITY","urgency":60,"family":"BESOIN_BIOLOGIQUE"},
