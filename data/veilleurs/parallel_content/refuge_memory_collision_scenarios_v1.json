      "candidates":[
        {"memory_id":"m.souvenir.one","priority_band":"DISCOVERY_OR_ARCHIVE","urgency":40,"family":"SOUVENIR"},
        {"memory_id":"m.discovery.one","priority_band":"DISCOVERY_OR_ARCHIVE","urgency":35,"family":"DECOUVERTE"}
