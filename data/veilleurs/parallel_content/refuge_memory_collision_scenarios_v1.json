    "same_source_hard_cooldown": true,
    "surface_limit_candidate": 2,
    "surface_limit_is_canon": false
  },
  "scenarios": [
    {
      "id":"collision.crisis_vs_work",
      "candidates":[
        {"memory_id":"m.work.repair","priority_band":"ROUTINE_OR_WORK","urgency":40,"age":3,"family":"TRAVAIL"},
        {"memory_id":"m.crisis.wounds","priority_band":"CRISIS","urgency":60,"age":1,"family":"CRISE"}
      ],
      "expected_order":["m.crisis.wounds","m.work.repair"],
      "reason":"priority_band_before_age"
    },
    {
      "id":"collision.body_vs_discovery",
      "candidates":[
        {"memory_id":"m.discovery.corpse","priority_band":"DISCOVERY_OR_ARCHIVE","urgency":85,"age":2,"family":"DECOUVERTE"},
        {"memory_id":"m.body.rest","priority_band":"BODY_OR_AVAILABILITY","urgency":30,"age":1,"family":"BESOIN_BIOLOGIQUE"}
      ],
      "expected_order":["m.body.rest","m.discovery.corpse"],
