      "current_expedition":41,
      "candidates":[
        {"memory_id":"m.corpse.new","source_event_id":"ref.decouverte.corpse_analysis","priority_band":"DISCOVERY_OR_ARCHIVE","family":"DECOUVERTE"},
        {"memory_id":"m.route.old","source_event_id":"ref.besoin_psychologique.before_return","priority_band":"DISCOVERY_OR_ARCHIVE","family":"BESOIN_PSYCHOLOGIQUE"}
