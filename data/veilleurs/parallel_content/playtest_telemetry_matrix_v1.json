{
  "version": 1,
  "status": "post_playtest_candidate_inactive",
  "enabled_by_default": false,
  "runtime_wiring": "none",
  "privacy": {
    "personally_identifiable_information": false,
    "free_text_capture": false,
    "raw_dialogue_or_player_text_capture": false,
    "account_identifier_capture": false,
    "session_identifier":"local_ephemeral_or_build_scoped",
    "purpose":"balance_and_usability_only"
  },
  "common_dimensions": ["build_id","session_id","run_id","act","seed","platform","input_mode"],
  "events": [
    {"id":"pt.session_start","fields":["build_id","platform","input_mode"]},
    {"id":"pt.session_end","fields":["duration_seconds","exit_reason"]},
    {"id":"pt.expedition_start","fields":["act","seed","party_size","persistent_injury_count","light_start_band"]},
    {"id":"pt.expedition_end","fields":["rooms_visited","encounters_completed","extraction_reason","survivors","persistent_injury_delta"]},
    {"id":"pt.room_enter","fields":["room_id","depth","light_band","noise_band","known_world_scars"]},
    {"id":"pt.room_leave","fields":["room_id","exit_kind","light_band","noise_band"]},
    {"id":"pt.light_band_change","fields":["from_band","to_band","cause_family"]},
    {"id":"pt.noise_band_change","fields":["from_band","to_band","cause_family"]},
    {"id":"pt.encounter_start","fields":["encounter_id","enemy_count","memorial_enemy_count","known_species_count"]},
    {"id":"pt.encounter_end","fields":["encounter_id","result","rounds","party_injury_delta","fear_peak_band"]},
    {"id":"pt.turn_decision_begin","fields":["actor_id","available_action_count","visible_intent_count"]},
    {"id":"pt.action_selected","fields":["actor_id","skill_runtime_id","action_family","selection_latency_ms"]},
    {"id":"pt.action_cancelled","fields":["actor_id","stage","reason_enum"]},
    {"id":"pt.target_mode_open","fields":["mode","candidate_count","auto_target_available"]},
    {"id":"pt.target_confirm","fields":["mode","target_kind","body_zone_or_none","confirmation_latency_ms"]},
    {"id":"pt.target_cancel","fields":["mode","cancel_stage"]},
    {"id":"pt.intent_inspected","fields":["enemy_runtime_id","canonical_knowledge_state","presentation_detail_level","current_perception_downgrade"]},
    {"id":"pt.body_state_change","fields":["actor_kind","zone","from_state","to_state","cause_family"]},
    {"id":"pt.bleeding_change","fields":["actor_kind","from_severity","to_severity"]},
    {"id":"pt.pain_change","fields":["actor_kind","from_band","to_band"]},
    {"id":"pt.shock_change","fields":["actor_kind","from_band","to_band"]},
    {"id":"pt.fear_band_change","fields":["watcher_id","from_band","to_band","cause_family"]},
    {"id":"pt.carry_started","fields":["carrier_id","carried_actor_kind","reason_enum"]},
    {"id":"pt.retreat_requested","fields":["round","party_critical_count","light_band","noise_band"]},
    {"id":"pt.extraction_committed","fields":["rooms_visited","objective_state","party_critical_count","known_route_pressure"]},
    {"id":"pt.rallying_opening","fields":["species_id","observable_condition_count","knowledge_state"]},
    {"id":"pt.rallying_attempt","fields":["species_id","result_enum","refuge_occupancy","candidate_wounded"]},
    {"id":"pt.archive_open","fields":["context","entity_id_or_none","section_or_none"]},
    {"id":"pt.archive_delta","fields":["entity_id","delta_kind","from_state_or_none","to_state_or_none"]},
    {"id":"pt.remanence_encounter","fields":["entity_id","memory_rank","shared_history_event_count","world_scar_linked"]},
    {"id":"pt.remanence_promotion","fields":["entity_id","from_rank","to_rank","promotion_source"]},
    {"id":"pt.refuge_screen_open","fields":["screen_id","refuge_occupancy","act"]},
    {"id":"pt.refuge_event_resolved","fields":["template_id","family","choice_id","participant_count"]}
  ],
  "derived_metrics": [
    {"id":"metric.decision_time_median","formula":"median(pt.action_selected.selection_latency_ms)","question":"Les combats demandent-ils de réfléchir sans devenir lents ?"},
    {"id":"metric.cancel_rate","formula":"action_cancelled / action_selected","question":"Les commandes ou intentions produisent-elles trop d'hésitations ou d'erreurs ?"},
    {"id":"metric.target_cancel_rate","formula":"target_cancel / target_mode_open","question":"Le ciblage anatomique est-il compréhensible ?"},
    {"id":"metric.explicit_body_target_share","formula":"target_confirm where body_zone_or_none != none / target_confirm","question":"Le joueur utilise-t-il réellement l'anatomie explicite ?"},
    {"id":"metric.intent_lookup_rate","formula":"intent_inspected / enemy_turn_opportunities","question":"Les télégraphes donnent-ils envie d'être consultés ?"},
    {"id":"metric.retreat_before_collapse","formula":"retreat_or_extraction with party_critical_count <= 1 / all retreats_or_extractions","question":"Le système apprend-il au joueur à partir avant la catastrophe ?"},
    {"id":"metric.light_low_exposure","formula":"time in low+critical+darkness / expedition duration","question":"La lumière crée-t-elle une pression réelle sans dominer toute la partie ?"},
    {"id":"metric.noise_high_exposure","formula":"time in alarming+roar / expedition duration","question":"Le bruit influence-t-il les décisions ?"},
    {"id":"metric.archive_contextual_use","formula":"archive_open during or immediately after encounter / encounters","question":"Les Archives servent-elles pendant l'apprentissage plutôt qu'après coup uniquement ?"},
    {"id":"metric.rallying_friction","formula":"rallying_attempt failures by reason / rallying_attempts","question":"Le ralliement est-il compris sans afficher de pourcentage caché ?"},
    {"id":"metric.injury_persistence_pressure","formula":"expeditions started with persistent injury / expeditions","question":"Les blessures persistantes influencent-elles réellement la composition ?"},
    {"id":"metric.remanence_recognition","formula":"archive_or_intent inspection within first round of memorial/nemesis encounter","question":"Le joueur reconnaît-il l'importance d'une entité qui revient ?"}
  ],
  "playtest_decision_rules": [
    "never_change_active_balance_from_one_session_only",
    "prefer repeated friction across different seeds before changing a core rule",
    "distinguish input friction from tactical difficulty",
    "distinguish knowledge uncertainty from unreadable UI",
    "change one balance family at a time when validating a hypothesis"
  ]
}
