  "cue_metadata": {
    "dismemberment": {"spatial":"3d","variants_min":4,"brief":"tactical bone/cloth/body layers; restrained gore"},
    "combat_telegraph": {"spatial":"2d","variants_min":4,"brief":"must cut through music"},
    "ultimate_release": {"spatial":"2d","variants_min":3,"brief":"unique signature per hero/tree"},
    "creature_conscious": {"spatial":"3d","variants_min":4,"brief":"intelligent presence; do not default to generic monster roar"},
    "fear_heartbeat": {"spatial":"2d","variants_min":3,"brief":"subjective and bounded by fear state"},
    "fear_tinnitus": {"spatial":"2d","variants_min":2,"brief":"brief subjective cue, never sustained as punishment"},
    "panic_sting": {"spatial":"2d","variants_min":3,"brief":"short perceptual collapse"},
    "hope_manifestation": {"spatial":"2d","variants_min":3,"brief":"opens air/clarity; no generic happy jingle"},
    "whisper_ambiguous": {"spatial":"3d","variants_min":4,"brief":"non-lexical or fully original voice only"},
    "wind_ashlands": {"spatial":"3d","variants_min":4,"brief":"dry wind and particulate hiss"},
    "bell_sanctuary": {"spatial":"3d","variants_min":3,"brief":"distinctive original Sanctuary identity"},
    "ui_error": {"spatial":"2d","variants_min":2,"brief":"restrained rejection; no arcade buzzer"},
    "ui_reward": {"spatial":"2d","variants_min":2,"brief":"small material cue; no casino feel"}
  },
  "layering_presets": [
    {"id":"blade_on_armor","layers":["combat_whoosh","weapon_blade_hit","armor_hit"],"rule":"attack transient first; material body second"},
    {"id":"critical_melee","layers":["combat_whoosh","weapon_blade_hit","critical_hit"],"rule":"short emphasis without masking reactions"},
    {"id":"dismemberment_tactical","layers":["weapon_blade_hit","bone_break","dismemberment","blood_gore_low"],"rule":"only relevant anatomy/material layers; gore stays lower"},
    {"id":"panic_subjective","layers":["fear_heartbeat","fear_breath","fear_tinnitus","panic_sting"],"rule":"brief layers; never sustain all at once"},
    {"id":"ashlands_exploration","layers":["wind_ashlands","cloth_movement","footstep_ash"],"rule":"leave acoustic space"},
    {"id":"boss_phase","layers":["boss_presence","boss_phase_change","debris_fall"],"rule":"spectacle never masks telegraphs"},
    {"id":"sanctuary_lived_in","layers":["sanctuary_crowd","forge_hammer","fire_camp"],"rule":"local qualitative density, not a wall of loops"}
  ],
  "implementation_rules": [
    "Gameplay readability outranks spectacle: telegraphs, parries, hits and interactions cut through music.",
    "Use 3D audio for world, creature and foley sources; reserve 2D for UI or subjective reinforcement.",
    "Frequently repeated cues need variants or bounded pitch/volume variation.",
    "Footsteps depend on surface and actor weight; equipment foley is layered separately.",
    "Bosses, ultimates and major creatures need bespoke final identities; stock sounds are source layers only.",
    "Never use intelligible stock dialogue as lore; narrative voices must be original or explicitly cleared.",
    "Human pain/effort recordings require provenance review beyond a permissive copyright label.",
    "Silence is a valid sound-design state after death, revelation and memorial scenes.",
    "Fear is subjective and should not saturate the whole mix.",
    "Hope opens space and clarity instead of using a generic positive notification.",
    "Sanctuary ambience evolves with people and buildings but remains sparse enough for dialogue.",
    "Creature families share acoustic DNA while conscious creatures retain intelligence in their sound design.",
    "Dismemberment stays serious and tactical; avoid exaggerated gore comedy.",
    "UI palette stays world-adjacent: paper, wood, leather, metal, breath and restrained tonal elements.",
    "Mobile mix is tested on iPhone speaker and headphones.",
    "Unique signature sounds are required for ultimates and major bosses."
  ],
  "ingestion_checklist": [
    "Open exact asset or pack page on download day.",
    "Confirm commercial game use is allowed.",
    "Reject non-commercial restrictions.",
    "Archive URL, creator, license/version and access date.",
    "Store license evidence.",
    "Record original filename and pack.",
    "Calculate SHA-256 of original file.",
    "Preserve metadata and provenance.",
    "Review consent/provenance for human voices.",
    "Convert only after provenance is stored.",
    "Document edits for attribution licenses.",
    "Loop only true ambience.",
    "Meet minimum variant count.",
    "Test against dialogue, music and telegraphs in Godot.",
    "Test on iPhone speaker and headphones.",
    "Set local_path only when verified audio exists."
  ],
  "mix_priorities": {
    "priority_order": ["critical_dialogue","combat_telegraph","player_action_feedback","enemy_action_feedback","interaction","ui","creature_vocals","foley","ambience","music"],
    "critical_dialogue_ducking_db": -8,
    "telegraph_target_peak_dbfs": -6,
    "ui_target_peak_dbfs": -10,
    "rule": "No repeated combat layer relies on master limiting for readability."
  },
  "naming_convention": {
    "pattern": "sfx_<domain>_<family>_<material_or_actor>_<variant>.<ext>",
    "examples": ["sfx_move_footstep_ash_01.ogg","sfx_combat_parry_steel_03.ogg","sfx_creature_ghoul_breath_02.ogg","sfx_ui_journal_page_01.ogg"]
  },
  "excluded_license_classes": [
    {"id":"cc_by_nc","reason":"non-commercial restriction"},
    {"id":"unknown_license","reason":"no explicit terms"},
    {"id":"editorial_only","reason":"not game-use clearance"},
    {"id":"recognizable_franchise","reason":"protected identity risk"},
    {"id":"unverified_voice","reason":"human voice provenance/consent risk"}
  ]
}
