  "signals":[
    {"id":"c06_sig_garden_growth","title":"Anneaux d'un arbre impossible","source_family":"material_anomaly","reliability":"authentic","text":"Le même tronc porte des anneaux de croissance correspondant à plusieurs siècles incompatibles.","supports":["continuity_beyond_closure"]},
    {"id":"c06_sig_garden_voice","title":"Voix entre les feuilles","source_family":"absent_voice","reliability":"unstable","text":"Une voix répond à une question qui n'a pas encore été posée, puis corrige sa réponse lorsque le groupe reformule.","supports":["conscious_survival"]},
    {"id":"c06_sig_shore_reply","title":"Réponse de la rive","source_family":"absent_voice","reliability":"responsive","text":"Trois appels espacés reçoivent trois réponses différentes mais cohérentes avec le même interlocuteur.","supports":["conscious_survival","stable_contact"]},
    {"id":"c06_sig_shore_saan","title":"Mesure de la Dernière Veille","source_family":"saan_record","reliability":"authentic","text":"Un appareil de Saan enregistre après la Grande Fermeture des motifs que ses opérateurs avaient classés comme réponses possibles.","supports":["continuity_beyond_closure","closure_risk"]},
    {"id":"c06_sig_doors_register","title":"Registre des Portes Muettes","source_family":"saan_record","reliability":"authentic","text":"Plusieurs portes furent maintenues fermées malgré des signaux internes après la fermeture du réseau.","supports":["closure_risk"]},
    {"id":"c06_sig_doors_knock","title":"Les quatre coups","source_family":"boundary_response","reliability":"repeatable","text":"Quatre coups reviennent uniquement lorsqu'un membre du groupe prononce son propre nom.","supports":["conscious_survival","stable_contact"]},
    {"id":"c06_sig_hamlet_table","title":"La table dressée deux fois","source_family":"civilian_echo","reliability":"partial","text":"La même famille apparaît autour de la même table à deux âges différents, sans se voir elle-même.","supports":["continuity_beyond_closure"]},
    {"id":"c06_sig_hamlet_child","title":"Comptine sans fin","source_family":"civilian_echo","reliability":"responsive","text":"Une enfant absente modifie une comptine lorsque Sela en change volontairement un vers.","supports":["conscious_survival","stable_contact"]},
    {"id":"c06_sig_creature_imprint","title":"Mémoire dans la pierre","source_family":"creature_imprint","reliability":"indirect","text":"Une créature réagit à un refuge disparu avant qu'aucun humain du groupe n'en identifie la forme.","supports":["carried_memory"]},
    {"id":"c06_sig_creature_name","title":"Un nom reconnu","source_family":"creature_imprint","reliability":"indirect","text":"Le rythme cardiaque de la créature change à l'énoncé d'un nom présent dans un registre vieux de plusieurs siècles.","supports":["carried_memory","stable_contact"]},
    {"id":"c06_sig_saen_name","title":"Je m'appelle Saen","source_family":"absent_voice","reliability":"responsive","text":"L'interlocuteur donne le même nom au cours de séquences séparées et se souvient d'informations échangées auparavant.","supports":["conscious_survival","stable_contact"]},
    {"id":"c06_sig_saen_plural","title":"Nous n'attendons pas tous au même endroit","source_family":"absent_voice","reliability":"responsive","text":"Saen distingue plusieurs groupes d'Absents et refuse de parler en leur nom collectif.","supports":["conscious_survival","closure_risk"]},
    {"id":"c06_sig_boundary_before","title":"Avant la limite","source_family":"boundary_response","reliability":"repeatable","text":"La frontière recule devant un ancrage partagé mais avance lorsque le groupe agit comme si elle était un simple ennemi.","supports":["stable_contact","closure_risk"]},
    {"id":"c06_sig_boundary_after","title":"Après la limite","source_family":"material_anomaly","reliability":"authentic","text":"Des objets déplacés au-delà de la frontière reviennent parfois avec une usure qui ne correspond pas au temps écoulé ici.","supports":["continuity_beyond_closure","closure_risk"]}
  ],
