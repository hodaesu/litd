{
  "schema_version": 3,
  "scope": "LITD Universe franchise pillars",
  "pillars": [
    {"id":"character_creation","name":"Création de personnages","permanent":true},
    {"id":"systemic_gore","name":"Gore systémique et conséquences corporelles","permanent":true},
    {"id":"philosophy_psychology_narrative","name":"Philosophie et psychologie dans la narration","permanent":true},
    {"id":"accessible_human_depth","name":"Profondeur humaine accessible","permanent":true,"target_effect":"Je comprends parfaitement ce qu'ils vivent. Je ne suis pas certain de ce que j'en pense."},
    {"id":"strong_narrative","name":"Narration forte","permanent":true},
    {"id":"cross_game_interconnection","name":"Interconnexion des jeux","permanent":true}
  ],
  "global_rules": [
    {
      "id": "absolute_narrative_coherence",
      "name": "Cohérence narrative absolue",
      "mandatory": true,
      "is_pillar": false,
      "rule": "Nothing happens because the plot needs it. Events must be permitted by established world rules, character knowledge, motivations, chronology and causality.",
      "reference": "docs/LITD_UNIVERSE_REGLE_COHERENCE_NARRATIVE.md",
      "forbidden": [
        "deus_ex_machina",
        "continuity_error",
        "silent_retcon",
        "retroactive_contrivance",
        "impossible_character_knowledge",
        "unmotivated_character_behavior",
        "plot_solving_coincidence",
        "unbounded_supernatural_fix",
        "consequence_disappearance_without_cause"
      ],
      "required_checks": [
        "chronology",
        "geography_and_travel_time",
        "character_knowledge",
        "character_motivation",
        "technology",
        "supernatural_rules",
        "causality",
        "short_term_consequences",
        "long_term_consequences",
        "cross_game_continuity"
      ],
      "inconsistency_policy": {
        "must_signal_user": true,
        "silent_fix_forbidden": true,
        "severity": ["BLOCKING","MAJOR","MINOR","OPEN_QUESTION"],
        "resolve_before_validation_if": ["BLOCKING","MAJOR"]
      }
    }
  ],
  "mandatory_writing_references": [
    "docs/LITD_UNIVERSE_BIBLIOTHEQUE_PHILO_PSYCHO.md",
    "docs/LITD_UNIVERSE_GUIDE_ECRITURE_PHILO_PSYCHO.md",
    "docs/LITD_UNIVERSE_REGLE_COHERENCE_NARRATIVE.md"
  ],
  "design_target": "Prefer systems and scenes that express several pillars at once while remaining causally and historically coherent."
}
