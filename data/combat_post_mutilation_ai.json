    "arachnid": {"state":"crippled_retreat","damage_multiplier":0.88,"fear_multiplier":0.90,"guard":true,"self_move":1,"protect_remaining":true},
    "aberration": {"state":"unstable_shift","damage_multiplier":1.05,"fear_multiplier":1.10,"guard":false,"self_move":-1,"protect_remaining":true},
    "construct": {"state":"structural_overload","damage_multiplier":1.12,"fear_multiplier":1.00,"guard":false,"self_move":0,"protect_remaining":false},
    "elite": {"state":"controlled_adaptation","damage_multiplier":1.00,"fear_multiplier":1.05,"guard":true,"self_move":0,"protect_remaining":true},
    "boss": {"state":"phase_adaptation","damage_multiplier":1.00,"fear_multiplier":1.05,"guard":true,"self_move":0,"protect_remaining":true}
