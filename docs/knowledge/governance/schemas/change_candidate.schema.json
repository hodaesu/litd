{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litd.local/schemas/change-candidate-v1.json",
  "title": "LITD governed change",
  "type": "object",
  "required": ["id", "decision_id", "status", "history", "test_plan", "rollback_plan", "evidence_ids", "guardian"],
  "properties": {
    "id": {"type": "string", "pattern": "^CHG-[A-Z0-9-]+$"},
    "decision_id": {"type": "string"},
    "status": {"enum": ["LITD_CHANGE_CANDIDATE", "TESTED", "APPROVED", "APPLIED", "MEASURED"]},
    "history": {"type": "array", "minItems": 1, "items": {"enum": ["LITD_CHANGE_CANDIDATE", "TESTED", "APPROVED", "APPLIED", "MEASURED"]}},
    "test_plan": {"type": "string", "minLength": 1},
    "rollback_plan": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "guardian": {"enum": ["GREEN", "ORANGE", "RED"]}
  },
  "additionalProperties": false
}
