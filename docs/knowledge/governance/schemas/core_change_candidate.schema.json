{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litd.local/schemas/core-change-candidate-v1.json",
  "title": "LITD Core change candidate",
  "type": "object",
  "required": [
    "id",
    "status",
    "knowledge_ids",
    "summary",
    "rationale",
    "pillars",
    "affected_paths",
    "risks",
    "contradictor_findings",
    "test_plan",
    "rollback_plan",
    "guardian",
    "human_approval",
    "core_write_allowed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CORE-CANDIDATE-[A-F0-9]{16}$"
    },
    "status": {
      "const": "REVIEW"
    },
    "knowledge_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^KNOW-[A-Z0-9-]+$"
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "pillars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "P1",
          "P2",
          "P3",
          "P4",
          "P5",
          "P6",
          "P7",
          "P8",
          "P9"
        ]
      },
      "uniqueItems": true
    },
    "affected_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contradictor_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "test_plan": {
      "type": "string",
      "minLength": 1
    },
    "rollback_plan": {
      "type": "string",
      "minLength": 1
    },
    "guardian": {
      "const": "ORANGE"
    },
    "human_approval": {
      "const": false
    },
    "core_write_allowed": {
      "const": false
    }
  },
  "additionalProperties": false
}
