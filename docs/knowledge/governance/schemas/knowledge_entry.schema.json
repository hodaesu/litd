{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litd.local/schemas/knowledge-entry-v1.json",
  "title": "LITD knowledge entry",
  "type": "object",
  "required": ["id", "domain", "claim", "status", "sources", "validated_at", "revalidate_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^KNOW-[A-Z0-9-]+$"},
    "domain": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "status": {"enum": ["ACTIVE", "EXPERIMENTAL", "REVALIDATE", "SUPERSEDED", "OBSOLETE", "REJECTED", "QUARANTINED"]},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "contradictions": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "validated_at": {"type": "string", "format": "date"},
    "revalidate_at": {"type": "string", "format": "date"}
  },
  "additionalProperties": false
}
